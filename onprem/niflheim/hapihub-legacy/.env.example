# hapihub v8 legacy archive — env reference for compose.yaml (mono#2295). Host: niflheim.
# The RUNTIME uses env.sh (shell `export`s, sourced before `docker compose up`), NOT env_file —
# PRIVATE_KEY/PUBLIC_KEY/STORAGE_PRIVATE_KEY are multiline PEMs; compose passes every var through via
# `environment: [KEY=${KEY}]`. Generate env.sh VERBATIM from the live v8 pod (`kubectl exec <hapihub-pod>
# -- env -0`), keeping all vars as-is and only localizing the mongo connection to the local container.
# env.sh is chmod 600, on-box only, NEVER committed. This file lists the vars for reference only.

# ---- MongoDB (points at the local mongo container) ----
MONGODB_USER=root
MONGODB_PASSWORD=<k8s secret "mongodb" key mongodb-root-password>
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=hapihub
# v8 reads MONGO_URI directly; components above must match it.
MONGO_URI=mongodb://root:<MONGODB_PASSWORD>@mongodb:27017/hapihub?replicaSet=rs0&directConnection=true&authSource=admin

# ---- Core / better-auth (non-secret, from values config + betterAuth blocks) ----
HOME=/tmp
PORT=7500
HAPIHUB_PORT=7500
# (the live prod v8 pod runs with PORT set — copy env.sh verbatim from it; no port:NaN issue in practice.)
EXTERNAL_ADDRESS=https://hapihub.localfirsthealth.com
# ^ kept as the original prod host for data/signature consistency. Browser better-auth login won't fully
#   work over tailnet (cookie-domain mismatch) — API access via service creds/direct queries is the point.
BETTER_AUTH_PASSKEY_RP_NAME=Mycure
BETTER_AUTH_PASSKEY_RP_ID=localfirsthealth.com
BETTER_AUTH_RATE_LIMIT_ENABLED=true
BETTER_AUTH_RATE_LIMIT_WINDOW=60
BETTER_AUTH_RATE_LIMIT_MAX=300
BETTER_AUTH_SESSION_COOKIE_CACHE_ENABLED=false
ACCOUNTS_SERVICE_ACCOUNT_EMAILS=service@mycure.md

# ---- CORS ----
CORS_ORIGINS=https://mycure.localfirsthealth.com,https://mycurev8.localfirsthealth.com,https://mycurev8-private.localfirsthealth.com,https://mycurelocal.localfirsthealth.com,https://mycure-myaccount.localfirsthealth.com,https://mycure-deploydash.localfirsthealth.com,https://mycure-dashboard.localfirsthealth.com,https://mycure-pxp.localfirsthealth.com,https://dentalemon.localfirsthealth.com,https://dentalemon-myaccount.localfirsthealth.com,https://dentalemon-website.localfirsthealth.com
CORS_STRICT=true
CORS_ALLOW_LOCAL_NETWORK=false
CORS_ALLOW_MOBILE_APPS=true

# ---- Secrets (GCP Secret Manager — remoteKey in comment) ----
PRIVATE_KEY=<mycure-production-private-key>
PUBLIC_KEY=<mycure-production-public-key>
AUTH_SECRET=<mycure-production-auth-secret>
BETTER_AUTH_SECRET=<mycure-production-better-auth-secret>

GOOGLE_CLIENT_ID=<mycure-production-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<mycure-production-google-oauth-client-secret>

# Field encryption keys (REQUIRED to read encrypted data — must match prod exactly)
ENC_BILLING_INVOICES=<mycure-production-enc-billing-invoices>
ENC_BILLING_ITEMS=<mycure-production-enc-billing-items>
ENC_BILLING_PAYMENTS=<mycure-production-enc-billing-payments>
ENC_MEDICAL_RECORDS=<mycure-production-enc-medical-records>
ENC_PERSONAL_DETAILS=<mycure-production-enc-personal-details>

# Blob storage — reuse the same external GCP bucket (lives outside the cluster)
STORAGE_TYPE=<mycure-production-storage-type>
STORAGE_BUCKET=<mycure-production-storage-bucket>
STORAGE_DIRECTORY=<mycure-production-storage-directory>
STORAGE_PROJECT_ID=<mycure-production-storage-project-id>
STORAGE_CLIENT_EMAIL=<mycure-production-storage-client-email>
STORAGE_PRIVATE_KEY=<mycure-production-storage-private-key>

STRIPE_SECRET_KEY=<mycure-production-stripe-secret-key>
STRIPE_KEY=<mycure-production-stripe-key>
STRIPE_CHECKOUT_SUCCESS_URL=<mycure-production-stripe-checkout-success-url>
STRIPE_CHECKOUT_CANCEL_URL=<mycure-production-stripe-checkout-cancel-url>
